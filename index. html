<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#124B91">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Chamaê">
<title>Chamaê — MVP conectado</title>
<style>
:root{--blue:#124B91;--orange:#F07822;--bg:#F4F7FB;--muted:#65758B;--line:#E3EAF2;--green:#168653;--red:#B42318}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172B45}
header{background:#fff;padding:13px 17px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:4;box-shadow:0 1px 5px #0001}
.logo{font-size:27px;font-weight:950;color:var(--blue);letter-spacing:-1px}.logo span{color:var(--orange)}.city{font-size:10px;font-weight:800;letter-spacing:1px;color:var(--muted)}
main{padding:17px 15px 110px;max-width:720px;margin:auto}h1{font-size:24px;margin:8px 0 4px;font-weight:900}h2{font-size:17px;margin:20px 0 8px}
.sub{font-size:13px;color:var(--muted);line-height:1.5;margin:5px 0 12px}
input,select,textarea{width:100%;padding:13px;border:1px solid #DCE4EF;border-radius:12px;font-size:16px;background:white;margin:7px 0;color:#172B45}
textarea{min-height:78px}.card{background:white;border:1px solid var(--line);border-radius:17px;padding:15px;margin:12px 0}
.row{display:flex;align-items:center;gap:12px}.avatar{width:48px;height:48px;border-radius:50%;background:#E7F0FF;color:var(--blue);display:grid;place-items:center;font-size:21px;font-weight:900;flex-shrink:0}
.name{font-weight:850}.rating{font-size:12px;color:#A66A10;margin-top:6px}.price{font-weight:900;color:var(--blue);margin-top:8px}
.between{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:10px;flex-wrap:wrap}
button{font:inherit;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}input,select,textarea{touch-action:manipulation}.action{width:100%;border:0;border-radius:12px;padding:13px;background:var(--blue);color:white;font-weight:850;margin-top:9px}
.secondary{background:#EAF1FA;color:var(--blue)}.orange{background:var(--orange);color:white}.danger{background:#FEECEB;color:var(--red)}
.link{border:0;background:none;color:var(--orange);font-weight:800;padding:8px 2px}
nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:9px 2px calc(9px + env(safe-area-inset-bottom));z-index:5;overflow-x:auto}
nav button{border:0;background:none;color:var(--muted);font-size:10px;font-weight:850;padding:7px 5px;white-space:nowrap}nav button.active{color:var(--blue)}
.small{font-size:10px;color:#8794A5;text-align:center;background:white;padding:5px 0 8px}
.tag{display:inline-block;border-radius:20px;background:#EDF4FF;color:var(--blue);padding:5px 9px;font-size:11px;font-weight:800}
.verified{display:inline-flex;align-items:center;gap:4px;border-radius:20px;background:#E7F7EE;color:#137547;padding:5px 9px;font-size:11px;font-weight:850}
.chat{background:#EAF1FA;border-radius:12px;padding:11px;margin:8px 0;max-width:90%;overflow-wrap:anywhere}.chat.mine{margin-left:auto;background:#E7F7EE}
.notice{padding:11px;border-radius:12px;background:#FFF6E8;color:#84500B;font-size:12px;line-height:1.45;margin:12px 0}
.error{color:#B42318;background:#FEF3F2;padding:10px;border-radius:10px;font-size:13px}.option{display:block;width:100%;text-align:left;background:white;border:1px solid #E1E7EF;border-radius:12px;padding:13px;margin:8px 0}
.option.selected{border:2px solid var(--blue);background:#EDF4FF}.service-row{border-top:1px solid var(--line);padding:11px 0}
.category-list{display:flex;flex-direction:column;gap:9px;margin:14px 0 20px}
.category-item{width:100%;display:flex;align-items:center;gap:15px;padding:13px 15px;background:#fff;border:1px solid #DCE5F1;border-radius:13px;color:#172B45;text-align:left;font-weight:850}
.category-icon{width:42px;font-size:27px;text-align:center}.category-arrow{margin-left:auto;color:var(--blue);font-size:22px}
.category-item.selected{border:2px solid var(--blue);background:#EDF4FF}
@media(min-width:900px){main{max-width:1080px;padding:28px 28px 110px}nav{justify-content:center;gap:30px}nav button{font-size:13px;padding:10px 14px}.card{padding:20px}}
</style>
</head>
<body>
<header><div class="logo">chama<span>ê</span></div><div class="city">JOINVILLE • SC</div></header>
<main id="app"><p>Carregando Chamaê...</p></main>
<nav>
<button data-tab="home" class="active">Início</button><button data-tab="orders">Serviços</button><button data-tab="favorites">Favoritos</button><button data-tab="chat">Chat</button><button data-tab="provider">Área profissional</button><button data-tab="admin" id="adminTab" style="display:none">Administração</button><button data-tab="profile">Perfil</button>
</nav>
<div class="small">Chamaê • painel administrativo integrado</div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
'use strict';
const SUPABASE_URL='https://rteeynlktogwjbjxezwr.supabase.co';
const SUPABASE_ANON_KEY='sb_publishable_p1JjWeb5D4l-TIGIKK5e8w_5z5j4_V6';
if(!window.supabase?.createClient){document.getElementById('app').innerHTML='<div class=\"error\">Não foi possível carregar a conexão do Chamaê. Verifique sua internet e recarregue a página.</div>';throw new Error('Biblioteca Supabase não carregou.')}
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);
const $=id=>document.getElementById(id);
const money=n=>Number(n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
let session=null,user=null,profile=null,tab='home',selected=null,selectedServiceId=null,selectedCategory=null,selectedProviderId=null,activeBooking=null;
let providers=[],services=[],bookings=[],messages=[],notifications=[],ratedBookingIds=[],loyaltyBonuses=[],loyaltyProgress={};
let favorites=[];try{favorites=JSON.parse(localStorage.getItem('chamae_favorites')||'[]');if(!Array.isArray(favorites))favorites=[]}catch{favorites=[]}
let chatRealtime=null,bookingRealtime=null,notificationRealtime=null;
let renderVersion=0;
let searchRenderTimer=null;
let isAdmin=false,adminDocuments=[],adminHistory=[];
const BASE_CATEGORIES=['Diarista','Manicure','Eletricista','Encanador','Babá','Cuidador de idosos','Personal trainer','Professor de música','Professor de idiomas','Pedreiro','Jardineiro','Serviços gerais','Multi serviços','Pintor','Mecânico','Marceneiro','Fotógrafo','Professor particular','Cuidador de pets'];
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function validCPF(value){let c=String(value||'').replace(/\D/g,'');if(c.length!==11||/^(\d)\1{10}$/.test(c))return false;let calc=(base,factor)=>{let sum=0;for(let n of base)sum+=Number(n)*factor--;let r=(sum*10)%11;return r===10?0:r};return calc(c.slice(0,9),10)===Number(c[9])&&calc(c.slice(0,10),11)===Number(c[10])}
function arg(s=''){return JSON.stringify(String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;')}
function card(s){return `<section class="card">${s}</section>`}
function btn(t,fn,k=''){return `<button class="action ${k}" onclick="${fn}">${t}</button>`}
function notice(s,k='notice'){return `<div class="${k}">${esc(s)}</div>`}
function dateToday(){let d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function icon(c=''){c=String(c).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();if(/diarist|limpeza|faxin/.test(c))return'🧹';if(/manicur|unha/.test(c))return'💅';if(/eletric/.test(c))return'⚡';if(/encan|hidraul/.test(c))return'🔧';if(/bab|cuidador/.test(c))return'🧸';if(/jardina/.test(c))return'🌿';if(/pintor/.test(c))return'🖌️';if(/pedreir|reforma/.test(c))return'🧱';if(/pet|animal/.test(c))return'🐾';if(/mecan|autom/.test(c))return'🚗';if(/personal/.test(c))return'🏋️';if(/professor|aula/.test(c))return'📚';return'🧰'}
async function clearChannel(ch){if(ch)try{await db.removeChannel(ch)}catch(e){console.warn('Falha ao encerrar canal realtime:',e)}}
async function clearRealtime(){await Promise.all([clearChannel(chatRealtime),clearChannel(bookingRealtime),clearChannel(notificationRealtime)]);chatRealtime=bookingRealtime=notificationRealtime=null}
async function loadProfile(){if(!user)return;let{data,error}=await db.from('profiles').select('*').eq('id',user.id).maybeSingle();if(error)throw error;profile=data}
async function ensureProfile(full='',phone='',role=null){
 if(!user)return;
 // Perfil existente nunca tem sua função sobrescrita pelo navegador.
 if(profile)return profile;
 let meta=user.user_metadata||{},safe=role||meta.role||'cliente';
 if(!['cliente','prestador'].includes(safe))safe='cliente';
 let payload={id:user.id,full_name:full||meta.full_name||user.email?.split('@')[0]||'Usuário',phone:phone||meta.phone||null,role:safe};
 let{data,error}=await db.from('profiles').insert(payload).select().single();
 if(error)throw error;profile=data;return profile;
}
async function loadProviders(){let{data,error}=await db.from('providers').select('id,user_id,name,category,area,rating,half_day_price,full_day_price,about,available').order('created_at',{ascending:false});if(error){console.warn(error);providers=[]}else providers=data||[]}
async function loadServices(){let{data,error}=await db.from('services').select('*').order('created_at',{ascending:false});if(error){console.warn(error);services=[]}else services=data||[]}
async function loadBookings(){if(!user)return;let{data,error}=await db.from('bookings').select('*').order('created_at',{ascending:false});if(error){console.warn(error);bookings=[]}else bookings=data||[]}
async function loadNotifications(){if(!user)return;let{data,error}=await db.from('notifications').select('*').eq('recipient_id',user.id).order('created_at',{ascending:false}).limit(30);if(error){console.warn(error);notifications=[]}else notifications=data||[]}
async function loadRated(){ratedBookingIds=[];let ids=bookings.filter(b=>b.client_id===user?.id&&b.status==='completed').map(b=>b.id);if(!ids.length)return;let{data,error}=await db.from('ratings').select('booking_id').in('booking_id',ids);if(!error)ratedBookingIds=(data||[]).map(x=>x.booking_id)}
async function loadLoyalty(){loyaltyBonuses=[];loyaltyProgress={};if(!user||profile?.role!=='prestador')return;let ids=providers.filter(p=>p.user_id===user.id).map(p=>p.id);if(!ids.length)return;let{data,error}=await db.from('provider_loyalty_bonuses').select('*').in('provider_id',ids).order('created_at',{ascending:false});if(error){console.warn(error);return}loyaltyBonuses=data||[];let{data:r,error:re}=await db.from('ratings').select('booking_id,provider_id').in('provider_id',ids).eq('score',5);if(re)return;let bookingIds=[...new Set((r||[]).map(x=>x.booking_id))],completed=[];if(bookingIds.length){let q=await db.from('bookings').select('id,provider_id').in('id',bookingIds).eq('status','completed');completed=q.data||[]}for(let id of ids){let n=completed.filter(b=>b.provider_id===id).length;loyaltyProgress[id]={total:n,completed:n%10,remaining:10-n%10}}}
function loyaltyView(ids){let rows=loyaltyBonuses.filter(x=>ids.includes(x.provider_id)),total=rows.reduce((a,x)=>a+Number(x.bonus_amount||0),0);return card(`<h2>Programa de fidelidade</h2><p class="sub">A cada 10 serviços concluídos com avaliação de 5 estrelas, bônus de 10% sobre o valor-base do décimo serviço do ciclo.</p>${ids.map(id=>{let p=providers.find(x=>x.id===id),d=loyaltyProgress[id]||{total:0,completed:0,remaining:10};return `<div class="service-row"><b>${esc(p?.name||'Profissional')}</b><p class="sub">${d.completed}/10 avaliações qualificadas · faltam ${d.remaining}</p><div style="height:9px;background:#e3eaf2;border-radius:10px"><div style="height:9px;width:${d.completed*10}%;background:#168653;border-radius:10px"></div></div></div>`}).join('')}<div class="between"><span class="sub">Bônus registrados</span><b class="price">${money(total)}</b></div>${rows.map(x=>`<p class="sub">Ciclo ${x.milestone_number}: ${money(x.bonus_amount)} · ${esc(x.status)}</p>`).join('')||'<p class="sub">Nenhum bônus registrado.</p>'}`)}
async function isVerified(id){let{data,error}=await db.from('provider_verifications').select('status').eq('provider_id',id).eq('status','verified').maybeSingle();return!error&&data?.status==='verified'}

async function checkAdmin(){
 isAdmin=false;
 if(!user)return false;
 const {data,error}=await db.rpc('chamae_is_admin');
 if(error){console.warn('Falha ao verificar acesso administrativo:',error);return false}
 isAdmin=data===true;
 return isAdmin;
}
async function loadAdminData(){
 if(!user||!isAdmin)throw new Error('Acesso administrativo não autorizado.');
 const {data,error}=await db.from('provider_documents').select('*').eq('status','pending').order('submitted_at',{ascending:false});
 if(error)throw error;
 adminDocuments=data||[];
 const {data:history,error:historyError}=await db.from('chamae_document_reviews').select('*').order('created_at',{ascending:false}).limit(50);
 if(historyError)throw historyError;
 adminHistory=history||[];
}
async function adminView(){
 if(!user||!isAdmin)return `<h1>Administração</h1>${notice('Acesso administrativo não autorizado.','error')}`;
 try{
  await loadAdminData();
  let html=`<h1>Painel administrativo</h1><p class="sub">Análise manual dos documentos dos profissionais.</p><div class="between"><span class="tag">${adminDocuments.length} cadastro(s) aguardando análise</span><button class="link" onclick="render()">Atualizar</button></div>`;
  if(!adminDocuments.length)html+=card('<p class="sub">Não existem documentos aguardando análise.</p>');
  for(const d of adminDocuments){
   const p=providers.find(x=>x.id===d.provider_id);
   const cpf=String(d.cpf||'').replace(/\D/g,'');
   const masked=cpf.length===11?cpf.slice(0,3)+'.***.***-'+cpf.slice(-2):'Não informado';
   let links='';
   for(const [label,path] of [['Documento de identidade',d.identity_path],['Comprovante de endereço',d.address_proof_path],['Foto para análise',d.photo_path]]){
    if(!path)continue;
    const {data,error}=await db.storage.from('provider-documents').createSignedUrl(path,120);
    links+=error||!data?.signedUrl?`<p class="sub">${label}: arquivo indisponível</p>`:`<p><a href="${esc(data.signedUrl)}" target="_blank" rel="noopener">${label} — visualizar</a></p>`;
   }
   html+=card(`<div class="between"><b>${esc(p?.name||d.legal_name||'Profissional')}</b><span class="tag">Pendente</span></div><p class="sub">${esc(p?.category||'')} · ${esc(p?.area||'')}</p><div class="service-row"><b>Dados para conferência</b><p class="sub">Nome: ${esc(d.legal_name||'')}</p><p class="sub">CPF: ${esc(masked)}</p><p class="sub">Nascimento: ${esc(d.birth_date||'')}</p><p class="sub">Telefone: ${esc(d.phone||'')}</p><p class="sub">Endereço: ${esc(d.address||'')}</p><p class="sub">Experiência: ${esc(d.experience||'Não informada')}</p></div><h3>Documentos privados</h3>${links}<textarea id="adminReason-${arg(d.provider_id)}" placeholder="Justificativa (obrigatória para rejeitar)"></textarea><button class="action" onclick="reviewDocument(${arg(d.provider_id)},'verified')">Aprovar documentação</button><button class="action danger" onclick="reviewDocument(${arg(d.provider_id)},'rejected')">Rejeitar documentação</button>`);
  }
  html+='<h2>Histórico de análises</h2>';
  html+=adminHistory.map(h=>card(`<div class="between"><b>${h.decision==='verified'?'Aprovado':'Rejeitado'}</b><span class="sub">${h.created_at?new Date(h.created_at).toLocaleString('pt-BR'):''}</span></div><p class="sub">Profissional: ${esc(h.provider_id)}</p><p class="sub">Justificativa: ${esc(h.reason||'Não informada')}</p>`)).join('')||card('<p class="sub">Nenhuma análise registrada.</p>');
  return html;
 }catch(e){console.error(e);return `<h1>Painel administrativo</h1>${notice('Erro ao carregar dados administrativos: '+e.message,'error')}`}
}
async function reviewDocument(providerId,decision){
 if(!user||!isAdmin)return alert('Acesso administrativo não autorizado.');
 const reason=$('adminReason-'+providerId)?.value.trim()||'';
 if(decision==='rejected'&&!reason)return alert('Informe a justificativa da rejeição.');
 if(!confirm(`Confirma ${decision==='verified'?'aprovar':'rejeitar'} esta documentação?`))return;
 const {error}=await db.rpc('chamae_review_provider_document',{p_provider_id:providerId,p_decision:decision,p_reason:reason||null});
 if(error)return alert('Não foi possível registrar a análise: '+error.message);
 await loadProviders();
 await loadAdminData();
 await render();
 alert(decision==='verified'?'Documentação aprovada.':'Documentação rejeitada e justificativa registrada.');
}

function authView(){return `<h1>Bem-vindo ao Chamaê</h1><p class="sub">Entre ou crie sua conta para contratar serviços ou oferecer seu trabalho.</p>${card(`<h2>Entrar</h2><input id="loginEmail" type="email" placeholder="Seu e-mail"><input id="loginPass" type="password" placeholder="Sua senha">${btn('Entrar','login()')}<hr><h2>Criar conta</h2><input id="newName" placeholder="Nome completo"><input id="newPhone" placeholder="Telefone / WhatsApp"><input id="newEmail" type="email" placeholder="E-mail"><input id="newPass" type="password" minlength="6" placeholder="Senha (mínimo 6 caracteres)"><select id="newRole"><option value="cliente">Quero contratar serviços</option><option value="prestador">Quero oferecer serviços</option></select>${btn('Criar minha conta','signup()','orange')}<p class="sub">A confirmação de cadastro segue a configuração do Supabase Auth.</p>`)}`}
async function login(){let email=$('loginEmail').value.trim(),password=$('loginPass').value;if(!email||!password)return alert('Informe e-mail e senha.');let{data,error}=await db.auth.signInWithPassword({email,password});if(error)return alert(error.message);session=data.session;user=data.user;try{await loadProfile();if(!profile)await ensureProfile();await refreshUserData();tab='home';await render()}catch(e){alert(e.message)}}
async function signup(){let full=$('newName').value.trim(),phone=$('newPhone').value.trim(),email=$('newEmail').value.trim(),password=$('newPass').value,role=$('newRole').value;if(!full||!email||password.length<6)return alert('Preencha nome, e-mail e senha com pelo menos 6 caracteres.');let{data,error}=await db.auth.signUp({email,password,options:{data:{full_name:full,phone,role}}});if(error)return alert(error.message);if(data.session){user=data.user;session=data.session;try{await ensureProfile(full,phone,role);await refreshUserData();tab='profile';await render();alert('Conta criada!')}catch(e){alert('Conta criada, mas não foi possível salvar o perfil: '+e.message)}}else alert('Conta criada. Confirme seu e-mail e depois entre no aplicativo.')}
async function refreshUserData(){await loadProfile();await checkAdmin();await loadProviders();await loadServices();await loadBookings();await loadNotifications();await loadRated();await loadLoyalty();await subscribeBookings();await subscribeNotifications()}
async function logout(){await clearRealtime();await db.auth.signOut();user=session=profile=null;isAdmin=false;adminDocuments=adminHistory=[];providers=services=bookings=messages=notifications=[];tab='home';selected=selectedServiceId=selectedCategory=activeBooking=null;await render()}
function providerCard(p){let count=services.filter(s=>s.provider_id===p.id).length;return card(`<div class="row"><div class="avatar">${icon(p.category)}</div><div style="flex:1"><b>${esc(p.name)}</b><div class="sub">${esc(p.category)} · ${esc(p.area||'Joinville')}</div><div class="rating">★ ${Number(p.rating||5).toFixed(1)}</div>${p._verified?'<span class="verified">✓ Perfil Verificado</span>':''}</div></div><div class="between"><span class="price">${count} serviço(s)</span><button class="link" onclick="toggleFavorite(${arg(p.id)})">${favorites.includes(p.id)?'♥ Salvo':'♡ Favoritar'}</button><button class="link" onclick="selectProvider(${arg(p.id)})">Ver serviços ›</button></div>`)}
async function home(){
 if(!user)return authView();
 let q=(window.searchQuery||'').toLowerCase().trim();
 let cats=[...new Set([...BASE_CATEGORIES,...providers.map(p=>p.category).filter(Boolean)])];
 let html=`<h1>Encontre profissionais</h1><p class="sub">Escolha uma categoria e encontre profissionais em Joinville e região.</p><input id="providerSearch" placeholder="Buscar serviço, profissional ou bairro" value="${esc(window.searchQuery||'')}" oninput="searchAndRender(this)"><div class="category-list">${cats.filter(c=>!q||c.toLowerCase().includes(q)||providers.some(p=>p.category?.toLowerCase()===c.toLowerCase()&&(p.name+' '+(p.area||'')).toLowerCase().includes(q))).map(c=>`<button class="category-item" onclick="openCategory(${arg(c)})"><span class="category-icon">${icon(c)}</span>${esc(c)}<span class="category-arrow">›</span></button>`).join('')}</div>`;
 if(selected){let p=providers.find(x=>x.id===selected);if(p)return html+await providerDetail(p)}
 if(selectedCategory){let list=providers.filter(p=>p.available&&p.category?.toLowerCase()===selectedCategory.toLowerCase()&&(!q||(p.name+' '+(p.area||'')+' '+p.category+' '+services.filter(s=>s.provider_id===p.id).map(s=>s.title+' '+s.description).join(' ')).toLowerCase().includes(q)));
 html+=`<h2>${icon(selectedCategory)} ${esc(selectedCategory)}</h2><button class="link" onclick="selectedCategory=null;render()">‹ Voltar</button>`;
 html+=list.length?(await Promise.all(list.map(async p=>{p._verified=await isVerified(p.id);return providerCard(p)}))).join(''):card('<p class="sub">Ainda não há profissionais correspondentes à busca.</p>');return html;}
 let matches=providers.filter(p=>p.available&&(!q||(p.name+' '+(p.area||'')+' '+p.category+' '+services.filter(s=>s.provider_id===p.id).map(s=>s.title+' '+s.description).join(' ')).toLowerCase().includes(q)));
 if(q){html+=`<h2>Resultados da busca</h2>`;html+=matches.length?(await Promise.all(matches.map(async p=>{p._verified=await isVerified(p.id);return providerCard(p)}))).join(''):card('<p class="sub">Nenhum profissional encontrado.</p>');}
 else html+=card('<p class="sub">Selecione uma categoria para visualizar profissionais.</p>');
 return html;
}
