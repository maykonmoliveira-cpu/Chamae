function profileView(){if(!user)return authView();return `<h1>Perfil</h1>${card(`<b>${esc(profile?.full_name||user.email)}</b><p class="sub">${esc(user.email)}</p><p class="sub">${esc(profile?.phone||'Telefone não informado')}</p><p class="sub">Tipo de conta: ${esc(profile?.role||'não definido')}</p>${btn('Sair da conta','logout()','secondary')}`)}<p class="notice">Favoritos ficam salvos neste aparelho. Verificação documental depende de revisão administrativa.</p>`}
async function render(){const version=++renderVersion;const currentTab=tab;let views={home,orders,favorites:favoritesPage,chat:chatView,provider:providerArea,admin:adminView,profile:profileView};let result=await (views[currentTab]||home)();if(version!==renderVersion||currentTab!==tab)return;$('app').innerHTML=result;document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));const adminButton=$('adminTab');if(adminButton)adminButton.style.display=isAdmin?'':'none'}
document.querySelectorAll('nav button').forEach(b=>b.addEventListener('click',async()=>{tab=b.dataset.tab;if(tab==='admin'&&!isAdmin){tab='home';return render()}if(tab==='chat'&&!activeBooking)activeBooking=bookings[0]?.id||null;if(tab==='chat'&&activeBooking){await loadMessages();await render();await subscribeChat()}else await render()}));
db.auth.onAuthStateChange((_e,s)=>{setTimeout(async()=>{session=s;user=s?.user||null;if(user){try{await loadProfile();if(!profile)await ensureProfile();await refreshUserData()}catch(e){console.error(e)}}else{await clearRealtime();profile=null;isAdmin=false;adminDocuments=adminHistory=[];providers=services=bookings=messages=notifications=[];activeBooking=null}await render()},0)});
async function init(){let{data,error}=await db.auth.getSession();if(error)console.warn(error);session=data.session;user=session?.user||null;if(user){await loadProfile();await refreshUserData()}else{await loadProviders();await loadServices()}await render()}
init().catch(e=>{$('app').innerHTML=notice('Erro ao iniciar o Chamaê: '+e.message,'error')});
</script>
</body>
